services:
  edge-caddy:
    image: caddy:2.8.4
    container_name: edge-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
      # 9081 removed (Internal Only Policy).
      # Health checks must use `docker inspect` or internal network.
    networks:
      - edge
      - heimnet
      # weltgewebe_default might be needed for direct API access if not routed via edge network
      # In current runtime, it seems Edge sits in weltgewebe_default too.
      - weltgewebe_default
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      # CA persistence via named volume (best practice)
      # Root CA export is a manual step (see runbooks/edge.sync.md)
      - edge_caddy_data:/data
      - edge_caddy_config:/config
      # Primary Static UI build path from Weltgewebe deployment
      # WARNING: This path MUST exist with proper ownership before starting edge-caddy.
      # If missing, Docker daemon will auto-create it as root:root, breaking subsequent Weltgewebe deployments.
      - /opt/weltgewebe/apps/web/build:/srv/weltgewebe-web:ro

networks:
  edge:
    external: true
  heimnet:
    external: true
  weltgewebe_default:
    external: true

volumes:
  edge_caddy_data:
  edge_caddy_config:
