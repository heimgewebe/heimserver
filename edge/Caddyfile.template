{
    admin 127.0.0.1:2019
    # Global options
    servers {
        trusted_proxies static private_ranges
    }
}

# --- Heimgewebe (Infrastructure) ---

http://leitstand.heimgewebe.home.arpa {
    redir https://leitstand.heimgewebe.home.arpa{uri} 308
}

https://leitstand.heimgewebe.home.arpa {
    tls internal
    reverse_proxy deploy-leitstand-1:3000
}


# --- Weltgewebe (Interface) ---

http://weltgewebe.home.arpa {
    redir https://weltgewebe.home.arpa{uri} 308
}

https://weltgewebe.home.arpa {
    tls internal

    handle_path /local-basemap/* {
        @pmtiles path_regexp \.pmtiles$
        handle @pmtiles {
            root * /srv/weltgewebe-basemap
            header Access-Control-Allow-Origin "*"
            header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            header Access-Control-Expose-Headers "Content-Range, Accept-Ranges, Content-Length"
            header Access-Control-Allow-Headers "Range, If-None-Match"
            @options {
                method OPTIONS
            }
            respond @options 204
            file_server
        }

        @meta path_regexp \.meta\.json$
        handle @meta {
            root * /srv/weltgewebe-basemap
            file_server
        }

        handle {
            root * /srv/weltgewebe-map-style
            file_server
        }
    }

    # Reverse proxy for API under the main domain
    redir /api /api/ 308
    handle_path /api/* {
        reverse_proxy weltgewebe-api:8080
    }

    handle /_app/immutable/* {
        root * /srv/weltgewebe-web
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle /_app/version.json {
        root * /srv/weltgewebe-web
        header Cache-Control "no-store"
        file_server
    }

    # Option A: Static UI (Default / Primary)
    # Serve static files from mounted volume if present.
    # Maps to /opt/weltgewebe/apps/web/build on the host
    handle {
        root * /srv/weltgewebe-web
        try_files {path} {path}/ /index.html
        header Cache-Control "no-cache, must-revalidate"
        file_server
    }

    # Security headers (minimal, aber vorhanden)
    header {
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none';"
    }
}

http://api.weltgewebe.home.arpa {
    redir https://api.weltgewebe.home.arpa{uri} 308
}

https://api.weltgewebe.home.arpa {
    tls internal
    # Upstream: Ensure this matches the Docker service name in the shared network.
    # Template uses 'weltgewebe-api' as the canonical service ID.
    # Note: This network alias MUST be enforced by the Weltgewebe deployment (docker-compose.yml).
    # If runtime only has 'weltgewebe-api-1', fix in Weltgewebe compose; do not hardcode unstable container names here.
    reverse_proxy weltgewebe-api:8080
}

# --- Weltgewebe Public Edge ---

weltgewebe.net, www.weltgewebe.net {
    encode zstd gzip

    handle_path /local-basemap/* {
        @pmtiles path_regexp \.pmtiles$
        handle @pmtiles {
            root * /srv/weltgewebe-basemap
            header Access-Control-Allow-Origin "*"
            header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
            header Access-Control-Expose-Headers "Content-Range, Accept-Ranges, Content-Length"
            header Access-Control-Allow-Headers "Range, If-None-Match"
            @options {
                method OPTIONS
            }
            respond @options 204
            file_server
        }

        @meta path_regexp \.meta\.json$
        handle @meta {
            root * /srv/weltgewebe-basemap
            file_server
        }

        handle {
            root * /srv/weltgewebe-map-style
            file_server
        }
    }

    handle_path /api/* {
        reverse_proxy weltgewebe-api:8080
    }

    handle /health/* {
        reverse_proxy weltgewebe-api:8080
    }

    handle /_app/immutable/* {
        root * /srv/weltgewebe-web
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle /_app/version.json {
        root * /srv/weltgewebe-web
        header Cache-Control "no-store"
        file_server
    }

    handle {
        root * /srv/weltgewebe-web
        try_files {path} {path}/ /index.html
        header Cache-Control "no-cache, must-revalidate"
        file_server
    }

    header {
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data: blob:; worker-src 'self' blob:; object-src 'none';"
    }
}

api.weltgewebe.net {
    encode zstd gzip
    reverse_proxy weltgewebe-api:8080

    header {
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
}
