#!/usr/bin/env bash
set -euo pipefail

# weltgewebe-up: Deployment and Health Check Logic
#
# PURPOSE:
#   Deploys Weltgewebe services (API, DB, optional Gateway).
#   Implements a prioritized health check strategy that supports unpublished ports.
#
# STRATEGY:
#   1. HEALTH_URL (Explicit override)
#   2. Docker Health (Preferred for internal services)
#   3. Host Port Check (Fallback, ONLY if published and != 0)
#   4. Gateway Check (Only if enabled)
#
# INVARIANTS:
#   - NEVER default to checking port 8081 (reserved for Pi-hole).
#   - Detect "0.0.0.0:0" or empty port as "unpublished".

log() { printf "[%s] %s\n" "$(date +'%H:%M:%S')" "$*"; }
warn() { printf "[%s] WARN: %s\n" "$(date +'%H:%M:%S')" "$*" >&2; }
fail() { printf "[%s] FAIL: %s\n" "$(date +'%H:%M:%S')" "$*" >&2; exit 1; }

REPO_DIR="${REPO_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo ".")}"
WELTGEWEBE_STATE_DIR="${WELTGEWEBE_STATE_DIR:-$REPO_DIR/.ops}"
COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.yml}" # Default, override if needed

# Ensure state dir exists
mkdir -p "$WELTGEWEBE_STATE_DIR"

check_health() {
    local service_name="weltgewebe-api"
    local max_retries=30
    local retry_delay=2

    log "Starting Health Check for '$service_name'..."

    # 1. Strategy: Explicit HEALTH_URL
    if [ -n "${HEALTH_URL:-}" ]; then
        log "Strategy: Explicit HEALTH_URL ($HEALTH_URL)"
        if command -v curl >/dev/null; then
            if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
                log "Health OK (Explicit URL)"
                return 0
            fi
        else
            warn "curl not found, skipping HEALTH_URL check."
        fi
    fi

    # 2. Strategy: Docker Health (Internal)
    # Check if container is running and has health status
    if command -v docker >/dev/null; then
        local health_status
        health_status=$(docker inspect --format='{{.State.Health.Status}}' "$service_name" 2>/dev/null || echo "unknown")

        if [ "$health_status" = "healthy" ]; then
            log "Health OK (Docker Health: healthy)"
            return 0
        elif [ "$health_status" = "starting" ]; then
            log "Service is starting..."
        elif [ "$health_status" = "unhealthy" ]; then
            warn "Docker Health reports: unhealthy"
        fi

        # If no healthcheck is defined in Dockerfile, status is usually empty or template fails
        # We fall through to port check if strictly needed, or trust "running" state if no port published.
    fi

    # 3. Strategy: Host Port Check (Fallback)
    # Only if port is published and != 0
    local host_port=""
    if command -v docker >/dev/null; then
        # Format: 0.0.0.0:8080 or ::1:8080 or empty
        host_port=$(docker compose port "$service_name" 8080 2>/dev/null || true)

        # Clean up port string (remove IP)
        if [ -n "$host_port" ]; then
            host_port="${host_port##*:}"
        fi
    fi

    if [ -n "$host_port" ] && [ "$host_port" != "0" ]; then
        log "Strategy: Host Port Check (Port $host_port)"
        if command -v curl >/dev/null; then
            if curl -fsS "http://127.0.0.1:$host_port/health/ready" >/dev/null 2>&1; then
                log "Health OK (Host Port $host_port)"
                return 0
            fi
        else
            warn "curl not found, skipping Host Port check."
        fi
    else
        log "Strategy Info: API Port not published (or 0). Skipping Host Port Check."
        # If we are here, and Docker Health was "healthy", we would have returned.
        # If Docker Health is missing/unknown, and Port is unpublished, we rely on container "running" state
        # as a weak signal, but ideally we want a real check.

        local container_state
        container_state=$(docker inspect --format='{{.State.Status}}' "$service_name" 2>/dev/null || echo "unknown")
        if [ "$container_state" = "running" ]; then
             log "Health OK (Weak: Container Running, No Port Published)"
             return 0
        fi
    fi

    # 4. Strategy: Gateway Check (Optional 9081)
    # Check if Gateway service is enabled and 9081 is bound
    if command -v ss >/dev/null; then
        if ss -lntup | grep -q ":9081"; then
             log "Strategy: Gateway Check (9081)"
             if command -v curl >/dev/null; then
                 if curl -fsS "http://127.0.0.1:9081/health/ready" >/dev/null 2>&1; then
                     log "Health OK (Gateway 9081)"
                     return 0
                 fi
             fi
        fi
    fi

    return 1
}

# Main Loop
log "Waiting for service readiness..."
for ((i=1; i<=30; i++)); do
    if check_health; then
        log "Deployment SUCCESS."
        exit 0
    fi
    sleep 2
done

fail "Deployment failed or timed out."
