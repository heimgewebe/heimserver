#!/usr/bin/env bash
set -euo pipefail

# weltgewebe-up: Deployment and Health Check Logic
#
# PURPOSE:
#   Deploys Weltgewebe services (API, DB).
#   Implements a strict "Internal Only" health check strategy.
#
# STRATEGY:
#   1. HEALTH_URL (Explicit override)
#   2. Docker Health (Strict requirement for internal services)
#
# INVARIANTS:
#   - NO Host Port Checks (8081, 9081, 8080 are NOT published).
#   - Services must report "healthy" via `docker inspect`.

log() { printf "[%s] %s\n" "$(date +'%H:%M:%S')" "$*"; }
warn() { printf "[%s] WARN: %s\n" "$(date +'%H:%M:%S')" "$*" >&2; }
fail() { printf "[%s] FAIL: %s\n" "$(date +'%H:%M:%S')" "$*" >&2; exit 1; }

REPO_DIR="${REPO_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || echo ".")}"
WELTGEWEBE_STATE_DIR="${WELTGEWEBE_STATE_DIR:-$REPO_DIR/.ops}"
COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.yml}" # Default, override if needed

# Ensure state dir exists
mkdir -p "$WELTGEWEBE_STATE_DIR"

check_health() {
    local service_name="weltgewebe-api"

    log "Starting Health Check for '$service_name'..."

    # 1. Strategy: Explicit HEALTH_URL
    if [ -n "${HEALTH_URL:-}" ]; then
        log "Strategy: Explicit HEALTH_URL ($HEALTH_URL)"
        if command -v curl >/dev/null; then
            if curl -fsS "$HEALTH_URL" >/dev/null 2>&1; then
                log "Health OK (Explicit URL)"
                return 0
            fi
        else
            warn "curl not found, skipping HEALTH_URL check."
        fi
    fi

    # 2. Strategy: Docker Health (Strict Internal)
    if command -v docker >/dev/null; then
        local health_status
        health_status=$(docker inspect --format='{{.State.Health.Status}}' "$service_name" 2>/dev/null || echo "unknown")

        if [ "$health_status" = "healthy" ]; then
            log "Health OK (Docker Health: healthy)"
            return 0
        elif [ "$health_status" = "starting" ]; then
            log "Service is starting..."
        elif [ "$health_status" = "unhealthy" ]; then
            warn "Docker Health reports: unhealthy"
        else
             # If unknown/empty, we check if at least running, but warn heavily.
             local state
             state=$(docker inspect --format='{{.State.Status}}' "$service_name" 2>/dev/null || echo "unknown")
             if [ "$state" = "running" ]; then
                 log "WARN: Container running but no HEALTHCHECK defined. Assuming OK."
                 return 0
             fi
        fi
    else
        fail "Docker not found. Cannot verify internal service health."
    fi

    return 1
}

# Main Loop
log "Waiting for service readiness..."
for ((i=1; i<=30; i++)); do
    if check_health; then
        log "Deployment SUCCESS."
        exit 0
    fi
    sleep 2
done

fail "Deployment failed or timed out (Docker Health check failed)."
