{
  servers {
    protocols h1 h2
  }
}

# --- Heimgewebe ---

http://leitstand.heimgewebe.home.arpa {
  redir https://leitstand.heimgewebe.home.arpa{uri} 308
}

https://leitstand.heimgewebe.home.arpa {
  # Service-Name muss dem Compose-Service entsprechen.
  # see infra/compose/compose.prod.yml (or equivalent)
  reverse_proxy deploy-leitstand-1:3000
  tls internal
}

# Optional: api.heimgewebe.home.arpa (nur wenn eigener Heimgewebe-Upstream existiert)
# NOTE: bewusst deaktiviert bis Heimgewebe-API (eigener Upstream) existiert.
# https://api.heimgewebe.home.arpa {
#   reverse_proxy <HEIMGEWEBE_API_UPSTREAM>:8080
#   tls internal
# }

# --- Weltgewebe ---

http://api.weltgewebe.home.arpa {
  redir https://api.weltgewebe.home.arpa{uri} 308
}

https://api.weltgewebe.home.arpa {
  # Service-Name muss dem Compose-Service entsprechen.
  # see infra/compose/compose.prod.yml (or equivalent)
  reverse_proxy weltgewebe-api:8080
  tls internal
}
